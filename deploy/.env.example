# Example environment for Phuong / Hermes on Hetzner

# Copy to deploy/.env (never commit secrets)

DOMAIN=your.host.example
# Clerk (UI build + API)
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Hermes (manager) model
DEFAULT_MODEL=kimi-coding/kimi-k3
KIMI_API_KEY=

# Optional other providers
ZAI_API_KEY=
ANTHROPIC_API_KEY=

# Pi worker tier routing (Hermes create_chat)
PHUONG_MODEL_T0=kimi-coding/kimi-k2.7
PHUONG_MODEL_T1=kimi-coding/kimi-k2.7
PHUONG_MODEL_T2=kimi-coding/kimi-k3
PHUONG_MODEL_T3=kimi-coding/kimi-k3
SUBAGENT_MODEL=kimi-coding/kimi-k2.7
SUBAGENT_MODEL_LIGHT=kimi-coding/kimi-k2.7
SUBAGENT_MODEL_COMPLEX=kimi-coding/kimi-k3
