# Example environment for Phuong (+ optional Hermes front-end)
#
# Copy to deploy/.env (never commit secrets)
# This stack is Phuong-only — do not share with other agent products.

DOMAIN=phuong.your.host.example
# Clerk (UI build + API)
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Phuong (manager) model
DEFAULT_MODEL=zai/glm-5.1
KIMI_API_KEY=

# z.ai / GLM (also used by Hermes as GLM_API_KEY)
ZAI_API_KEY=
ANTHROPIC_API_KEY=

# Pi worker tier routing (Phuong create_chat)
PHUONG_MODEL_T0=zai/glm-5-turbo
PHUONG_MODEL_T1=zai/glm-5-turbo
PHUONG_MODEL_T2=zai/glm-5.1
PHUONG_MODEL_T3=zai/glm-5.1
SUBAGENT_MODEL=zai/glm-5-turbo
SUBAGENT_MODEL_LIGHT=zai/glm-5-turbo
SUBAGENT_MODEL_COMPLEX=zai/glm-5.1

# Hermes front-end (installed by ./deploy.sh kanban when an LLM key is set)
HERMES_PROVIDER=zai
HERMES_MODEL=glm-5.1
# Optional: enable systemd Hermes gateway for Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
